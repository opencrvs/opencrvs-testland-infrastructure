all:
  vars:
    ansible_user: provision
    single_node: false
    kube_cluster_env: local-dev
    users: []

  children:
    master:
      hosts:
        master:
          ansible_host: '11.11.11.11'
          ansible_ssh_common_args: '-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
          labels:
            traefik-role: ingress
            role: data1

    workers:
      hosts:
        worker0:
          ansible_host: '10.10.10.10'
          ansible_ssh_common_args: '-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
          labels:
            role: data2
